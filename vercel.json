{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "startCommand": "npm start",
  "output": "standalone",
  "env": {
    "DATABASE_URL": {
      "fromEnv": true
    },
    "NEXTAUTH_URL": {
      "fromEnv": true
    },
    "NEXTAUTH_SECRET": {
      "fromEnv": true
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/((?!api|_next)).*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}