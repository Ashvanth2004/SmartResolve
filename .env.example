# ── Database (MongoDB) ───────────────────────────────────
# APP_DB=mock  -> zero-setup in-memory demo data (recommended for local demo)
# APP_DB=mongo -> real MongoDB; set MONGODB_URI to your local or Atlas cluster
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB=smartresolve
APP_DB=mock

# ── Auth ─────────────────────────────────────────────────
# After deploy: set to your Vercel URL, e.g. https://smart-resolve.vercel.app
NEXTAUTH_URL=https://your-app.vercel.app
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# ── App ──────────────────────────────────────────────────
# After deploy: set to your Vercel URL
NEXT_PUBLIC_BASE_URL=https://your-app.vercel.app
NEXT_PUBLIC_SITE_NAME=ResolveAI
APP_ENV=production

# ── AI ───────────────────────────────────────────────────
AI_ENABLED=true
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
AI_REVIEW_THRESHOLD=70
AI_SIMILARITY_THRESHOLD=35

# ── Email (verification mails) ───────────────────────────
EMAIL_ENABLED=true
EMAIL_VERIFICATION_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your@gmail.com

# ── Web search (AI research mode) ────────────────────────
WEB_SEARCH_PROVIDER=duckduckgo
WEB_SEARCH_MAX_RESULTS=10
WEB_SEARCH_TIMEOUT=15000

# ── Uploads ──────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880
